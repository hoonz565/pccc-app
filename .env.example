APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

POSTGRES_DB=firesafe
POSTGRES_USER=firesafe
POSTGRES_PASSWORD=firesafe_dev_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://firesafe:firesafe_dev_password@127.0.0.1:5432/firesafe

# Local development authentication values only. Production must inject a
# strong secret through its deployment environment.
AUTH_SIGNING_SECRET=local-development-only-change-this-signing-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
TERMS_VERSION=draft-v1
PRIVACY_VERSION=draft-v1
